# ============================================================
# CMS Blue Button Sandbox
# Example configuration only.
#
# NEVER place real credentials in this file.
# Copy to .env locally when credentials are available.
# .env is excluded by .gitignore.
# ============================================================

CMS_BLUEBUTTON_CLIENT_ID=
CMS_BLUEBUTTON_CLIENT_SECRET=

CMS_BLUEBUTTON_REDIRECT_URI=http://localhost:8080/callback

# The implemented configuration contract requires v3.
CMS_BLUEBUTTON_API_VERSION=v3

CMS_BLUEBUTTON_SANDBOX_BASE_URL=https://sandbox.bluebutton.cms.gov
